# Copy to .env.local and fill in. Never commit .env.local.
# Values here are placeholders or local-only defaults.

# ── Database ────────────────────────────────────────────────────────────────
# Local: `npm run db:up` starts PostgreSQL 17 in Docker on 127.0.0.1:54320.
DATABASE_URL=postgresql://scamurai:scamurai_local@127.0.0.1:54320/scamurai
# Used by drizzle-kit (migrations). Same database locally; on Cloud SQL use a
# user that may run DDL.
MIGRATE_URL=postgresql://scamurai:scamurai_local@127.0.0.1:54320/scamurai
# TLS to the database. `disable` only for local Docker or the Cloud SQL Auth Proxy.
DATABASE_SSL=disable

# ── Site ────────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin used in emails and invitation links.
APP_URL=http://localhost:3000
# Secret path segment of the admin console (/<locale>/<ADMIN_SLUG>/...).
ADMIN_SLUG=change-me
# Content-Security-Policy: enforce (default), report-only or off. Violations
# are logged as "[csp]" lines either way.
# CSP_MODE=enforce

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "Scamurai <noreply@your-domain>". Unset = Resend sandbox.
RESEND_FROM_ADDRESS=
# Dev only: every email is redirected here. Leave unset in production.
RESEND_DEV_FALLBACK_EMAIL=you@example.com
# Receives new-application notifications.
SUPER_ADMIN_EMAIL=you@example.com

# ── Rate limiting (Upstash Redis, production only) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# X-Forwarded-For entries our proxies append after the client's IP. Default 1
# (Google Cloud's external Application Load Balancer); check it in staging.
# TRUSTED_PROXY_HOPS=1

# ── File storage ───────────────────────────────────────────────────────────
# local: files under .storage/ (development). gcs: Google Cloud Storage (production).
STORAGE_DRIVER=local
# gcs only: bucket names (private buckets, same region as the app).
STORAGE_BUCKET_ORDER_IMAGES=
STORAGE_BUCKET_BRAND_ASSETS=
# local only: optional overrides.
# STORAGE_LOCAL_DIR=.storage
# STORAGE_SIGNING_SECRET=change-me
